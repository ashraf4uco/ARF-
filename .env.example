# RAZORPAY_KEY_ID: Public key for Razorpay checkout (client-side)
# Required for frontend payment initialization
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_PUBLIC_KEY"

# RAZORPAY_KEY_SECRET: Private secret for signature verification (server-side)
# NEVER expose this on the frontend
RAZORPAY_KEY_SECRET="YOUR_PRIVATE_SECRET"

# RAZORPAY_WEBHOOK_SECRET: Secret for validating incoming webhooks
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
